generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Aubrey - Bus Route, ServiceDay, BusStop, RouteSchedule

enum ServiceDay {
  Weekday
  Saturday
  Sunday
}

model BusRoute {
  id              Int         @id @default(autoincrement())
  routeNumber     String      @unique
  routeName       String
  desciption      String
  busNumber       Int
  neighbourhood   String
  stops           BusStop[]
  schedule       RouteSchedule[]
}

model BusStop {
  id              Int         @id @default(autoincrement())
  routeId         Int
  busStopNumber   Int
  route           BusRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, busStopNumber])
  @@unique([routeId])

}

model RouteSchedule {
  id          Int     @id @default(autoincrement())
  routeId     Int     
  serviceDay  ServiceDay
  time        String
  route       BusRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, serviceDay])
}

















// Keith - Complaint

















// Abdel - Complaint Update
model ComplaintUpdate {
  id          Int      @id @default(autoincrement())
  complaintId Int
  status      String
  adminNote   String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [complaintId], onDelete: Cascade)
}
